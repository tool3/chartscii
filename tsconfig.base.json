{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noImplicitAny": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "chartscii.ts",
    "types/**/*.ts",
    "options/**/*.ts",
    "formatters/**/*.ts",
    "processor/**/*.ts",
    "validator/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "shellfies",
    "branding",
    "**/*.test.ts",
    "index.test.ts"
  ]
}
