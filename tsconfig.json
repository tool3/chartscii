{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "index.ts",
    "chartscii.ts",
    "types/**/*.ts",
    "options/**/*.ts",
    "formatters/**/*.ts",
    "processor/**/*.ts",
    "validator/**/*.ts",
    "index.test.ts"
  ]
}
