{
  "name": "chartscii",
  "version": "3.2.0",
  "description": "awesome ascii charts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tool3/chartscii"
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "mocha -r ts-node/register index.test.ts",
    "print": "node -e \"const keys = require('./snapshots/index.test'); Object.keys(keys).map(key => console.log(key + '\\n' + keys[key].join('\\n'))) \" "
  },
  "keywords": [
    "bar-chart",
    "cli",
    "ascii",
    "chart"
  ],
  "author": "Tal Hayut",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@types/chai": "4.3.14",
    "@types/mocha": "10.0.6",
    "chai": "4.2.0",
    "mocha": "^11.3.0",
    "snaptdout": "^2.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "styl3": "3.1.1"
  }
}
